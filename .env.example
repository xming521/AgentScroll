# 必填：名称需与 settings.jsonc 中的 api.api_key_env 一致。
AGENTSCROLL_LLM_API_KEY=

# 使用 AstrBot transport 自动分享时必填；需使用具备 im scope 的 AstrBot API Key。
AGENTSCROLL_ASTRBOT_API_KEY=

# 容器按这个时区解释 settings.jsonc 中的执行时间。
TZ=Asia/Shanghai

# 热榜类别。
AGENTSCROLL_HOTLIST_GROUPS=综合

# NewsNow 默认固定到已验证的发布版本；需要升级时显式修改。
NEWSNOW_VERSION=v0.0.41
NEWSNOW_PORT=4444

# 只有采集 Product Hunt 时才需要。
PRODUCTHUNT_API_TOKEN=
