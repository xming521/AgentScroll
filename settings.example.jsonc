{
  // 推理后端："api" 使用 OpenAI 兼容接口；"codex_exec" 使用本机 Codex CLI。
  "provider": "api",

  // API 或 Codex CLI 实际使用的模型名。使用前必须替换该占位值。
  "model": "replace-with-model-name",

  // 模型与补搜请求的最大并发数；保持与共享推理代码的默认值一致。
  "max_workers": 10,

  "api": {
    // 从这个环境变量读取 API Key，配置文件本身不保存密钥。
    "api_key_env": "AGENTSCROLL_LLM_API_KEY",

    // OpenAI 兼容服务的 /v1 根地址。
    "base_url": "https://api.openai.com/v1"
  },

  "codex_exec": {
    // Codex 模型推理强度。
    "effort": "low"
  },

  "storage": {
    // 跨轮次热点、标题缓存和分享任务共用的 SQLite 数据库。
    "database_path": "outputs/agentscroll.sqlite3"
  },

  "schedule": {
    // 在每日执行时间范围内，从进程启动时刻起按此间隔检查并执行。
    "every": "2h",

    // 使用运行机器的当地时间；跨越午夜时，结束时间属于次日。
    "start_time": "08:00",
    "end_time": "00:00"
  },

  "interest": {
    // 兴趣关键词，可以是具体词、人物、产品或领域；空数组表示不启用兴趣偏好。
    "keywords": [],
    // 不喜欢的关键词，第一轮按事件主体语义排除；空数组表示不排除。
    "blocked_keywords": [],
    // 不喜欢的关键词，但保留新事件的各档热度保底机会；空数组表示不启用。
    "soft_blocked_keywords": []
  },

  "hotlist": {
    // 关闭后仅按兴趣或原有热度规则入选，大众分享分为 0。
    "builtin_content_enabled": true,
    // 标题数达标优先入选采集，并设定新事件热度保底的 4 分档门槛；较低档见 docs/design.md。
    "force_share_title_count": 3
  },

  "sharing": {
    // 只在 hotlist run --scheduled 的常驻进程中自动分享。
    "enabled": false,
    "destinations": [],
    "policy": {
      "mode": "window",
      "delivery": {
        // 正文与评论整组串行；相邻分享含 immediate 时按秒级间隔。
        "min_interval_minutes": 10,
        // 非 null 时不得低于当前 mode 的 min_score；null 关闭即时待遇。
        "immediate_score": 4.0,
        "immediate_interval_seconds": 3
      },
      "window": {
        "min_score": 3.0,
        // 每个目标分别限制普通分享。
        "window_minutes": 60,
        "max_messages_per_window": 2
      },
      "score_only": {
        // 只发送达到 min_score 的消息。
        "min_score": 4.0
      }
    }
  },

  "integrations": {
    "astrbot": {
      // AgentScroll 在宿主机运行时使用本机地址；Docker Compose 会通过环境变量覆盖。
      "base_url": "http://127.0.0.1:6185",
      "api_key_env": "AGENTSCROLL_ASTRBOT_API_KEY"
    }
  }
}
